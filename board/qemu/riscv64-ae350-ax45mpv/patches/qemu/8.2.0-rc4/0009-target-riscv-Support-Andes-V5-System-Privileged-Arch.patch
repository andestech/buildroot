diff --git a/target/riscv/csr_andes.inc.c b/target/riscv/csr_andes.inc.c
new file mode 100644
index 0000000000..7d33821a59
--- /dev/null
+++ b/target/riscv/csr_andes.inc.c
@@ -0,0 +1,219 @@
+/*
+ * Andes custom CSR table and handling functions
+ *
+ * Copyright (c) 2021 Andes Technology Corp.
+ * SPDX-License-Identifier: GPL-2.0+
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/main-loop.h"
+#include "exec/exec-all.h"
+#include "andes_cpu_bits.h"
+#include "csr_andes.inc.h"
+
+static RISCVException read_mmsc_cfg(CPURISCVState *env,
+                                    int csrno,
+                                    target_ulong *val)
+{
+    *val = env->andes_csr.mmsc_cfg;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_uitb(CPURISCVState *env,
+                                 int csrno,
+                                 target_ulong val)
+{
+    env->andes_csr.uitb = val;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException read_uitb(CPURISCVState *env,
+                                int csrno,
+                                target_ulong *val)
+{
+    *val = env->andes_csr.uitb;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_mmisc_ctl(CPURISCVState *env,
+                                     int csrno,
+                                     target_ulong val)
+{
+    env->andes_csr.mmisc_ctl = val;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException read_mmisc_ctl(CPURISCVState *env,
+                                     int csrno,
+                                     target_ulong *val)
+{
+    *val = env->andes_csr.mmisc_ctl;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException any(CPURISCVState *env,
+                          int csrno)
+{
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException read_zero(CPURISCVState *env,
+                                int csrno,
+                                target_ulong *val)
+{
+    *val = 0;
+    return RISCV_EXCP_NONE;
+}
+
+static RISCVException write_stub(CPURISCVState *env,
+                                 int csrno,
+                                 target_ulong val)
+{
+    return RISCV_EXCP_NONE;
+}
+
+void andes_csr_init(AndesCsr *andes_csr)
+{
+    int i;
+
+    /* Register CSR read/write method */
+    for (i = 0; i < CSR_TABLE_SIZE; i++) {
+        if (andes_csr_ops[i].name != NULL) {
+            riscv_set_csr_ops(i, &andes_csr_ops[i]);
+        }
+    }
+
+    /* Initilaize CSR default value */
+    andes_csr->uitb = 0;
+    andes_csr->mmsc_cfg =   (1UL << V5_MMSC_CFG_ECD) |
+                            (1UL << V5_MMSC_CFG_PPMA);
+    andes_csr->mmisc_ctl =  (1UL << V5_MMISC_CTL_BRPE) |
+                            (1UL << V5_MMISC_CTL_MSA_OR_UNA);
+}
+
+riscv_csr_operations andes_csr_ops[CSR_TABLE_SIZE] = {
+    /* ================== AndeStar V5 machine mode CSRs ================== */
+    /* Configuration Registers */
+    [CSR_MICM_CFG]  = { "micm_cfg",          any, read_zero,      write_stub},
+    [CSR_MDCM_CFG]  = { "mdcm_cfg",          any, read_zero,      write_stub},
+    [CSR_MMSC_CFG]  = { "mmsc_cfg",          any, read_mmsc_cfg,  write_stub},
+    [CSR_MMSC_CFG2] = { "mmsc_cfg2",         any, read_zero,      write_stub},
+    [CSR_MVEC_CFG]  = { "mvec_cfg",          any, read_zero,      write_stub},
+
+    /* Crash Debug CSRs */
+    [CSR_MCRASH_STATESAVE]  = { "mcrash_statesave",  any, read_zero,
+                                write_stub                                  },
+    [CSR_MSTATUS_CRASHSAVE] = { "mstatus_crashsave", any, read_zero,
+                                write_stub                                  },
+
+    /* Memory CSRs */
+    [CSR_MILMB]          = { "milmb",             any, read_zero, write_stub},
+    [CSR_MDLMB]          = { "mdlmb",             any, read_zero, write_stub},
+    [CSR_MECC_CODE]      = { "mecc_code",         any, read_zero, write_stub},
+    [CSR_MNVEC]          = { "mnvec",             any, read_zero, write_stub},
+    [CSR_MCACHE_CTL]     = { "mcache_ctl",        any, read_zero, write_stub},
+    [CSR_MCCTLBEGINADDR] = { "mcctlbeginaddr",    any, read_zero, write_stub},
+    [CSR_MCCTLCOMMAND]   = { "mcctlcommand",      any, read_zero, write_stub},
+    [CSR_MCCTLDATA]      = { "mcctldata",         any, read_zero, write_stub},
+    [CSR_MPPIB]          = { "mppib",             any, read_zero, write_stub},
+    [CSR_MFIOB]          = { "mfiob",             any, read_zero, write_stub},
+
+    /* Hardware Stack Protection & Recording */
