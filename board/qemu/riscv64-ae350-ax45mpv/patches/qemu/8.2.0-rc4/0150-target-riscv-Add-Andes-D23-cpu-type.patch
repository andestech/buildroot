---
 target/riscv/cpu-qom.h |  1 +
 target/riscv/cpu.c     | 86 ++++++++++++++++++++++--------------------
 2 files changed, 47 insertions(+), 40 deletions(-)

diff --git a/target/riscv/cpu-qom.h b/target/riscv/cpu-qom.h
index a539392a62..7d6b360df9 100644
--- a/target/riscv/cpu-qom.h
+++ b/target/riscv/cpu-qom.h
@@ -35,6 +35,7 @@
 #define TYPE_RISCV_CPU_ANDES_AX45       RISCV_CPU_TYPE_NAME("andes-ax45")
 #define TYPE_RISCV_CPU_ANDES_AX45MPV    RISCV_CPU_TYPE_NAME("andes-ax45mpv")
 #define TYPE_RISCV_CPU_ANDES_AX65       RISCV_CPU_TYPE_NAME("andes-ax65")
+#define TYPE_RISCV_CPU_ANDES_D23        RISCV_CPU_TYPE_NAME("andes-d23")
 #define TYPE_RISCV_CPU_ANDES_N25        RISCV_CPU_TYPE_NAME("andes-n25")
 #define TYPE_RISCV_CPU_ANDES_N45        RISCV_CPU_TYPE_NAME("andes-n45")
 #define TYPE_RISCV_CPU_ANDES_NX25       RISCV_CPU_TYPE_NAME("andes-nx25")
diff --git a/target/riscv/cpu.c b/target/riscv/cpu.c
index 1e1a7dc15c..b2e8ca2ef7 100644
--- a/target/riscv/cpu.c
+++ b/target/riscv/cpu.c
@@ -689,6 +689,7 @@ static void rv128_base_cpu_init(Object *obj)
 }
 
 static void rv64_andes_common_cpu_init(Object *obj,
+                                       uint8_t satp_mode,
                                        fp_spec_csr_init_fn spec_csr_init)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
@@ -702,7 +703,8 @@ static void rv64_andes_common_cpu_init(Object *obj,
     env->priv_ver = PRIV_VERSION_1_12_0;
 
 #ifndef CONFIG_USER_ONLY
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_SV48);
+    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
+    set_satp_mode_max_supported(RISCV_CPU(obj), satp_mode);
 #endif
 
     /* Setup Andes Custom CSR */
@@ -737,7 +739,7 @@ static void rv64_andes_ax25_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
 
-    rv64_andes_common_cpu_init(obj, NULL);
+    rv64_andes_common_cpu_init(obj, VM_1_10_SV48, NULL);
 
     /* Set CPU ID */
     cfg->marchid = 0x8a25;
@@ -747,7 +749,7 @@ static void rv64_andes_ax27_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
 
-    rv64_andes_common_cpu_init(obj, NULL);
+    rv64_andes_common_cpu_init(obj, VM_1_10_SV48, NULL);
 
     /* Set CPU ID */
     cfg->marchid = 0x8a27;
@@ -757,7 +759,7 @@ static void rv64_andes_ax45_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
 
-    rv64_andes_common_cpu_init(obj, andes_set_mmsc_cfg_l2c);
+    rv64_andes_common_cpu_init(obj, VM_1_10_SV48, andes_set_mmsc_cfg_l2c);
 
     /* Set CPU ID */
     cfg->marchid = 0x8a45;
@@ -770,7 +772,7 @@ static void rv64_andes_ax45mpv_cpu_init(Object *obj)
 
     riscv_cpu_set_misa(env, MXL_RV64,
              RVI | RVM | RVA | RVF | RVD | RVC | RVS | RVU | RVV | RVX);
-    rv64_andes_common_cpu_init(obj, andes_set_mmsc_cfg_l2c);
+    rv64_andes_common_cpu_init(obj, VM_1_10_SV48, andes_set_mmsc_cfg_l2c);
 
     /* Set CPU ID */
     cfg->marchid = 0x8a45;
@@ -791,7 +793,7 @@ static void rv64_andes_ax65_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
 
-    rv64_andes_common_cpu_init(obj, andes_set_mmsc_cfg_l2c);
+    rv64_andes_common_cpu_init(obj, VM_1_10_SV48, andes_set_mmsc_cfg_l2c);
 
     /* Set CPU ID */
     cfg->marchid = 0x8a65;
@@ -839,12 +841,8 @@ static void rv64_andes_nx25_cpu_init(Object *obj)
 
     riscv_cpu_set_misa(env, MXL_RV64,
              RVI | RVM | RVA | RVF | RVD | RVC | RVU | RVX);
-    rv64_andes_common_cpu_init(obj, NULL);
+    rv64_andes_common_cpu_init(obj, VM_1_10_MBARE, NULL);
     cfg->mmu = false;
-#ifndef CONFIG_USER_ONLY
-    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_MBARE);
-#endif
 
     /* Set CPU ID */
     cfg->marchid = 0x8025;
@@ -857,12 +855,8 @@ static void rv64_andes_nx27v_cpu_init(Object *obj)
 
     riscv_cpu_set_misa(env, MXL_RV64,
              RVI | RVM | RVA | RVF | RVD | RVC | RVU | RVV | RVX);
-    rv64_andes_common_cpu_init(obj, NULL);
+    rv64_andes_common_cpu_init(obj, VM_1_10_MBARE, NULL);
     cfg->mmu = false;
-#ifndef CONFIG_USER_ONLY
-    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_MBARE);
-#endif
 
     /* RVV extension */
     cfg->vlen = 512;
@@ -879,12 +873,8 @@ static void rv64_andes_nx45_cpu_init(Object *obj)
 
     riscv_cpu_set_misa(env, MXL_RV64,
              RVI | RVM | RVA | RVF | RVD | RVC | RVU | RVX);
-    rv64_andes_common_cpu_init(obj, NULL);
+    rv64_andes_common_cpu_init(obj, VM_1_10_MBARE, NULL);
     cfg->mmu = false;
-#ifndef CONFIG_USER_ONLY
-    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_MBARE);
-#endif
 
     /* Set CPU ID */
     cfg->marchid = 0x8045;
@@ -897,12 +887,8 @@ static void rv64_andes_nx45v_cpu_init(Object *obj)
 
     riscv_cpu_set_misa(env, MXL_RV64,
              RVA | RVC | RVD | RVF | RVI | RVM | RVN | RVU | RVV | RVX);
-    rv64_andes_common_cpu_init(obj, andes_spec_csr_init_nx45v);
+    rv64_andes_common_cpu_init(obj, VM_1_10_MBARE, andes_spec_csr_init_nx45v);
     cfg->mmu = false;
-#ifndef CONFIG_USER_ONLY
-    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_MBARE);
-#endif
 
     /* Set CPU extensions */
     cfg->ext_zfh = true;
@@ -1001,6 +987,7 @@ static void rv32_imafcu_nommu_cpu_init(Object *obj)
 typedef void (*fp_csr_init_fn)(AndesCsr *);
 
 static void rv32_andes_common_cpu_init(Object *obj,
+                                       uint8_t satp_mode,
                                        fp_csr_init_fn spec_csr_init)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
@@ -1014,7 +1001,8 @@ static void rv32_andes_common_cpu_init(Object *obj,
     env->priv_ver = PRIV_VERSION_1_12_0;
 
 #ifndef CONFIG_USER_ONLY
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_SV32);
+    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
+    set_satp_mode_max_supported(RISCV_CPU(obj), satp_mode);
 #endif
 
     /* Setup Andes Custom CSR */
@@ -1049,7 +1037,7 @@ static void rv32_andes_a25_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
 
-    rv32_andes_common_cpu_init(obj, NULL);
+    rv32_andes_common_cpu_init(obj, VM_1_10_SV32, NULL);
 
     /* Set CPU ID */
     cfg->marchid = 0x0a25;
@@ -1059,7 +1047,7 @@ static void rv32_andes_a27_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
 
-    rv32_andes_common_cpu_init(obj, NULL);
+    rv32_andes_common_cpu_init(obj, VM_1_10_SV32, NULL);
 
     /* Set CPU ID */
     cfg->marchid = 0x0a27;
@@ -1069,12 +1057,37 @@ static void rv32_andes_a45_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
 
-    rv32_andes_common_cpu_init(obj, andes_set_mmsc_cfg_l2c);
+    rv32_andes_common_cpu_init(obj, VM_1_10_SV32, andes_set_mmsc_cfg_l2c);
 
     /* Set CPU ID */
     cfg->marchid = 0x0a45;
 }
 
+static void rv32_andes_d23_cpu_init(Object *obj)
+{
+    RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
+    CPURISCVState *env = &RISCV_CPU(obj)->env;
+
+    riscv_cpu_set_misa(env, MXL_RV32,
+                       RVI | RVM | RVA | RVC | RVS | RVU | RVX);
+    rv32_andes_common_cpu_init(obj, VM_1_10_MBARE, andes_set_mmsc_cfg_l2c);
+
+    /* Set CPU ID */
+    cfg->marchid = 0x00023;
+
+    /* Scalar crypto */
+    cfg->ext_zk  = true;
+    cfg->ext_zks = true;
+
+    /* Debug sdtrig extension optional CSR */
+    cfg->ext_sdtrig_tcontrol = true;
+    cfg->ext_sdtrig_mcontext = true;
+
+    /* smePMP */
+    cfg->pmp = true;
+    cfg->ext_smepmp = true;
+}
+
 static void rv32_andes_n25_cpu_init(Object *obj)
 {
     RISCVCPUConfig *cfg = &RISCV_CPU(obj)->cfg;
@@ -1082,12 +1095,8 @@ static void rv32_andes_n25_cpu_init(Object *obj)
 
     riscv_cpu_set_misa(env, MXL_RV32,
              RVI | RVM | RVA | RVF | RVD | RVC | RVU | RVX);
-    rv32_andes_common_cpu_init(obj, NULL);
+    rv32_andes_common_cpu_init(obj, VM_1_10_MBARE, NULL);
     cfg->mmu = false;
-#ifndef CONFIG_USER_ONLY
-    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_MBARE);
-#endif
 
     /* Set CPU ID */
     cfg->marchid = 0x0025;
@@ -1116,12 +1125,8 @@ static void rv32_andes_n45_cpu_init(Object *obj)
 
     riscv_cpu_set_misa(env, MXL_RV32,
              RVI | RVM | RVA | RVF | RVD | RVC | RVU | RVX);
-    rv32_andes_common_cpu_init(obj, NULL);
+    rv32_andes_common_cpu_init(obj, VM_1_10_SV32, NULL);
     cfg->mmu = false;
-#ifndef CONFIG_USER_ONLY
-    memset(&cfg->satp_mode, 0, sizeof(RISCVSATPMap));
-    set_satp_mode_max_supported(RISCV_CPU(obj), VM_1_10_MBARE);
-#endif
 
     /* Set CPU ID */
     cfg->marchid = 0x0045;
@@ -2551,6 +2556,7 @@ static const TypeInfo riscv_cpu_type_infos[] = {
     DEFINE_CPU(TYPE_RISCV_CPU_ANDES_A25,        rv32_andes_a25_cpu_init),
     DEFINE_CPU(TYPE_RISCV_CPU_ANDES_A27,        rv32_andes_a27_cpu_init),
     DEFINE_CPU(TYPE_RISCV_CPU_ANDES_A45,        rv32_andes_a45_cpu_init),
+    DEFINE_CPU(TYPE_RISCV_CPU_ANDES_D23,        rv32_andes_d23_cpu_init),
     DEFINE_CPU(TYPE_RISCV_CPU_ANDES_N25,        rv32_andes_n25_cpu_init),
     DEFINE_CPU(TYPE_RISCV_CPU_ANDES_N45,        rv32_andes_n45_cpu_init),
     DEFINE_DYNAMIC_CPU(TYPE_RISCV_CPU_BASE32,   rv32_base_cpu_init),
