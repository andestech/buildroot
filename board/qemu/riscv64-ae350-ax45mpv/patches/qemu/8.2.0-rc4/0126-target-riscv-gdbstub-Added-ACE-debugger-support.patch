@@ -1466,6 +1633,13 @@ static const GdbCmdParseEntry gdb_v_commands_table[] = {
         .cmd_startswith = 1,
         .schema = "s0"
     },
+#else /* System emulatin use original codes for ACE/gdb */
+    {
+        .handler = handle_v_file,
+        .cmd = "File:",
+        .cmd_startswith = 1,
+        .schema = "s0"
+    },
 #endif
 };
 
