@@ -26,27 +26,27 @@ typedef struct ACR_info_v5 {
 typedef enum {
   acr_io1 = 0, acr_io2 = 1,
   acm_io1 = 2, acm_io2 = 3
-} INSN_TYPE_V5;
+} AceInsnType;
 
-typedef struct Util_Insn {
-  INSN_TYPE_V5 version;
+typedef struct {
+  AceInsnType version;
   unsigned insn;
-} UTIL_INSN_T_V5;
+} AceUtilInsn;
 
-typedef struct Insn_Code {
+typedef struct {
   unsigned num;
-  UTIL_INSN_T_V5 *code;
-} INSN_CODE_T_V5;
+  AceUtilInsn *code;
+} AceInsnCode;
 
-extern unsigned *global_acr_reg_count_v5;
-extern unsigned *global_acr_type_count_v5;
