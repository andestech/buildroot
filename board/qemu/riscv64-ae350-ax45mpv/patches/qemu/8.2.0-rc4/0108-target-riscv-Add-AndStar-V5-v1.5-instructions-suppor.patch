+#define OPFVF9(NAME, TD, T1, T2, TX1, TX2, HD, HS1, HS2, OP)                \
+static void do_##NAME(void *vd, uint64_t s1, uint64_t s2,                   \
+        void *vs2, int i, CPURISCVState *env)                               \
