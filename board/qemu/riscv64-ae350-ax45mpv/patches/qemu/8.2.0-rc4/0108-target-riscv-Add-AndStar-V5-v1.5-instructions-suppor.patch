+#define GEN_VEXT_VF_TB(NAME, ESZ)                         \
+void HELPER(NAME)(void *vd, void *v0, uint64_t s1,        \
+                  uint64_t tb,                            \
+                  void *vs2, CPURISCVState *env,          \
+                  uint32_t desc)                          \
+{                                                         \
+    uint32_t vm = vext_vm(desc);                          \
+    uint32_t vl = env->vl;                                \
