+    /* tb is true for top, false for bottom */            \
+    if (tb == true) {                                     \
+        top = ((s1 >> 16) & 0xffff);                      \
+        bottom = (s1 & 0xffff);                           \
+    } else {                                              \
+        top = (s1 & 0xffff);                              \
+        bottom = ((s1 >> 16) & 0xffff);                   \
