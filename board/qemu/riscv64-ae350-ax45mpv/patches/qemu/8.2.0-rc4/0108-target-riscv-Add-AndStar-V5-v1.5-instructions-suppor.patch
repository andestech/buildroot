+/* Vector Signed Dot Product on 1/4 of SEW */
+#define OPIVV9(NAME, TD, T1, T2, TX1, TX2, HD, HS1, HS2, OP, OP2)       \
+static void do_##NAME(void *vd, void *vs1, void *vs2, int i)            \
+{                                                                       \
+    int j;                                                              \
+    TD sum = 0;                                                         \
+    for (j = 0; j < 4; j++) {                                           \
+        TX1 s1 = *((T1 *)vs1 + HS1(i + j));                             \
+        TX2 s2 = *((T2 *)vs2 + HS2(i + j));                             \
+        sum = OP2(s2, s1, sum);                                         \
+    }                                                                   \
+    TD d = *((TD *)vd + HD(i));                                         \
+    *((TD *)vd + HD(i)) = OP(d, sum);                                   \
+}
