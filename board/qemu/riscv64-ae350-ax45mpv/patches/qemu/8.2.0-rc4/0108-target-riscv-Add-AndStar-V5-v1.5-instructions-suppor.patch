+            continue;                                     \
+        }                                                 \
+        do_##NAME(vd, top, bottom, vs2, i, env);          \
+    }                                                     \
+    env->vstart = 0;                                      \
+    /* set tail elements to 1s */                         \
+    vext_set_elems_1s(vd, vta, vl * ESZ,                  \
+                      total_elems * ESZ);                 \
+}
