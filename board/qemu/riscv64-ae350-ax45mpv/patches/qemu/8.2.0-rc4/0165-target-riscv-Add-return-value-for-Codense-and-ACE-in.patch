From 31147d5540011da0884b7c76cd6d98ef8a8ec86e Mon Sep 17 00:00:00 2001
From: Foxes Hung <foxes687@andestech.com>
Date: Thu, 4 Jan 2024 09:45:40 +0800
Subject: [PATCH 165/241] target/riscv: Add return value for Codense and ACE
 instruction translation at some situation

Signed-off-by: Foxes Hung <foxes687@andestech.com>
---
 target/riscv/insn_trans/trans_xandesace.c.inc        |  1 +
 target/riscv/insn_trans/trans_xandescodenseops.c.inc | 11 ++++++-----
 2 files changed, 7 insertions(+), 5 deletions(-)

diff --git a/target/riscv/insn_trans/trans_xandesace.c.inc b/target/riscv/insn_trans/trans_xandesace.c.inc
index 3c6b6af274..8f7a264ae5 100644
--- a/target/riscv/insn_trans/trans_xandesace.c.inc
+++ b/target/riscv/insn_trans/trans_xandesace.c.inc
@@ -18,6 +18,7 @@ static bool trans_andes_ace(DisasContext *ctx, arg_andes_ace *a)
     if (!ctx->cfg_ptr->ext_XAndesAce) {
         qemu_printf("XAndesAce not set\n");
         riscv_raise_exception(cpu_env(ctx->cs), RISCV_EXCP_ILLEGAL_INST, GETPC());
+        return false;
     }
     REQUIRE_ACE;
     REQUIRE_ACES;
diff --git a/target/riscv/insn_trans/trans_xandescodenseops.c.inc b/target/riscv/insn_trans/trans_xandescodenseops.c.inc
index 6ac5a93fba..52442a6888 100644
--- a/target/riscv/insn_trans/trans_xandescodenseops.c.inc
+++ b/target/riscv/insn_trans/trans_xandescodenseops.c.inc
@@ -57,7 +57,7 @@
     } \
 } while (0)
 
-static void decode_opc_andes(CPURISCVState *env,
+static bool decode_opc_andes(CPURISCVState *env,
                              DisasContext *ctx,
                              uint32_t opcode)
 {
@@ -89,13 +89,13 @@ static void decode_opc_andes(CPURISCVState *env,
     if (extract16(opcode16, 0, 2) != 3) {
         if (!has_ext(ctx, RVC)) {
             gen_exception_illegal(ctx);
+            return false;
         } else {
             ctx->opcode = opcode16;
-
             for (size_t i = 0; i < ARRAY_SIZE(decoders_16); ++i) {
                 if (decoders_16[i].guard_func(ctx->cfg_ptr) &&
                     decoders_16[i].decode_func(ctx, opcode16)) {
-                    return;
+                    return true;
                 }
             }
         }
@@ -104,12 +104,13 @@ static void decode_opc_andes(CPURISCVState *env,
         for (size_t i = 0; i < ARRAY_SIZE(decoders); ++i) {
             if (decoders[i].guard_func(ctx->cfg_ptr) &&
                 decoders[i].decode_func(ctx, opcode)) {
-                return;
+                return true;
             }
         }
     }
 
     gen_exception_illegal(ctx);
+    return false;
 }
 
 static bool andes_v5_gen_codense_exec_it(DisasContext *ctx,
@@ -150,7 +151,7 @@ static bool andes_v5_gen_codense_exec_it(DisasContext *ctx,
     } else {
         /* JARL done as SPEC already */
         /* presume ctx->pc_succ_insn not changed in any ISA extension */
-        decode_opc_andes(env, ctx, insn);
+        return decode_opc_andes(env, ctx, insn);
     }
     return true;
 }
-- 
