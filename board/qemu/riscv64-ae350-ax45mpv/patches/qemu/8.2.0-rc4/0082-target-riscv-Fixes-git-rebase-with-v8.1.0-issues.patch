     riscv_cpu_add_user_properties(obj);
     register_andes_cpu_props(obj);
-    set_priv_version(env, PRIV_VERSION_1_12_0);
+    env->priv_ver = PRIV_VERSION_1_12_0;
 
 #ifndef CONFIG_USER_ONLY
