+static bool trans_find_first_x(DisasContext *ctx, int rd,
+                               int rs1, int rs2, int func)
+{
+    TCGv src1, src2, dest, tmp;
+    src1 = get_gpr(ctx, rs1, EXT_NONE);
+    src2 = get_gpr(ctx, rs2, EXT_NONE);
+    dest = get_gpr(ctx, rd,  EXT_NONE);
