From b59514552bfed42eef0cc92524ebb82d68603d34 Mon Sep 17 00:00:00 2001
From: Dylan Jhong <dylan@andestech.com>
Date: Fri, 10 Dec 2021 16:55:23 +0800
Subject: [PATCH 008/241] atcsmu: Support ATCSMU on AE350

We need the ATCSMU to help us with QEMU power management.
In this patch, we support poweroff command with legacy register SMUCR.

This should be modified to PCS_CTL in the future.

ref:
    91cc7a1998 atcsmu: Support ATCSMU on AE350
    6b7f11d9ee atcsmu: Support atcsmu with reboot feature.

Signed-off-by: Dylan Jhong <dylan@andestech.com>
Reviewed-by: Locus Wei-Han Chen <locus84@andestech.com>
Reviewed-by: Leo Yu-Chi Liang <ycliang@andestech.com>
---
 hw/riscv/Kconfig                |   4 ++
 hw/riscv/andes_ae350.c          |   5 +-
 hw/riscv/andes_atcsmu.c         | 124 ++++++++++++++++++++++++++++++++
 hw/riscv/meson.build            |   1 +
 include/hw/riscv/andes_atcsmu.h |  49 +++++++++++++
 5 files changed, 181 insertions(+), 2 deletions(-)
 create mode 100644 hw/riscv/andes_atcsmu.c
 create mode 100644 include/hw/riscv/andes_atcsmu.h

diff --git a/hw/riscv/Kconfig b/hw/riscv/Kconfig
index 615fa03785..1ccb60c694 100644
--- a/hw/riscv/Kconfig
+++ b/hw/riscv/Kconfig
@@ -5,12 +5,16 @@ config IBEX
     bool
 
 # RISC-V machines in alphabetical order
+config ATCSMU
+    bool
+
 config ANDES_AE350
     bool
     select ANDES_PLIC
     select ANDES_PLMT
     select ATCDMAC300
     select ATCPIT100
+    select ATCSMU
     select ATFMAC100
     select ATFSDC010
     select SERIAL
diff --git a/hw/riscv/andes_ae350.c b/hw/riscv/andes_ae350.c
index fe5b952df0..3512e91c26 100644
--- a/hw/riscv/andes_ae350.c
+++ b/hw/riscv/andes_ae350.c
@@ -47,6 +47,7 @@
 #include "hw/timer/andes_plmt.h"
 #include "hw/timer/atcpit100.h"
 #include "hw/riscv/andes_ae350.h"
+#include "hw/riscv/andes_atcsmu.h"
 #include "hw/sd/atfsdc010.h"
 
 #define BIOS_FILENAME ""
@@ -356,8 +357,8 @@ static void andes_ae350_soc_realize(DeviceState *dev_soc, Error **errp)
     }
 
     /* SMU */
-    create_unimplemented_device("riscv.andes.ae350.smu",
-        memmap[ANDES_AE350_SMU].base, memmap[ANDES_AE350_SMU].size);
+    andes_atcsmu_create(memmap[ANDES_AE350_SMU].base,
