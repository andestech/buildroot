     /* SMC */
     create_unimplemented_device("riscv.andes.ae350.smc",
diff --git a/hw/riscv/andes_atcsmu.c b/hw/riscv/andes_atcsmu.c
new file mode 100644
index 0000000000..5ae1ebcbf2
--- /dev/null
+++ b/hw/riscv/andes_atcsmu.c
@@ -0,0 +1,124 @@
