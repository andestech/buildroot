+static bool riscv_pmu_has_andes_pmnds(RISCVCPU *cpu)
+{
+    if (cpu->cfg.ext_XAndesV5Ops == false) {
+        return false;
+    }
+
+    target_ulong mmsc_cfg = cpu->env.andes_csr.csrno[CSR_MMSC_CFG];
+
+    if (mmsc_cfg & MASK_MMSC_CFG_PMNDS) {
+        return true;
+    } else {
+        return false;
+    }
+}
