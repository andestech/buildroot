 hw/intc/andes_plic.c         |   4 +-
 target/riscv/csr_andes.inc.c | 256 +++++++++++++++--------------------
 target/riscv/csr_andes.inc.h |   8 +-
 3 files changed, 114 insertions(+), 154 deletions(-)

